---
const year = new Date().getFullYear();

const nav = [
  {
    heading: 'Меблі',
    links: [
      { href: '/kataloh',           label: 'Весь каталог' },
      { href: '/kataloh#stoly',     label: 'Столи' },
      { href: '/kataloh#stiltsi',   label: 'Стільці' },
      { href: '/kataloh#bari',      label: 'Барні стійки' },
      { href: '/kataloh#lavky',     label: 'Дивани та лавки' },
    ],
  },
  {
    heading: 'Компанія',
    links: [
      { href: '/pro-nas',        label: 'Про нас' },
      { href: '/portfolio',      label: 'Портфоліо' },
      { href: '/dlya-biznesu',   label: 'Для бізнесу' },
      { href: '/kontakty',       label: 'Контакти' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <!-- Brand column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="HoReCa Меблі — на головну">
        <svg width="40" height="40" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <rect width="64" height="64" rx="10" fill="var(--color-primary)"/>
          <text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle"
            font-family="Georgia, serif" font-size="26" font-weight="700" fill="#FAF7F2">HM</text>
        </svg>
        <span class="footer-logo-name">HoReCa Меблі</span>
      </a>
      <p class="footer-desc">
        Дерев'яні меблі ручної роботи для ресторанів, кафе та готелів.
        Власне виробництво. Індивідуальний підхід до кожного проєкту.
      </p>
      <div class="footer-contacts">
        <a href="tel:+380001234567" class="contact-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          +38 (000) 123-45-67
        </a>
        <a href="mailto:info@horeca-meybli.com" class="contact-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
          info@horeca-meybli.com
        </a>
      </div>
      <div class="social-links">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://t.me" target="_blank" rel="noopener noreferrer" aria-label="Telegram">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Nav columns -->
    {nav.map(({ heading, links }) => (
      <div class="footer-nav-col">
        <h3 class="footer-heading">{heading}</h3>
        <ul>
          {links.map(({ href, label }) => (
            <li><a href={href} class="footer-link">{label}</a></li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Working hours -->
    <div class="footer-nav-col">
      <h3 class="footer-heading">Графік роботи</h3>
      <ul class="hours-list">
        <li><span>Пн – Пт</span><span>9:00 – 18:00</span></li>
        <li><span>Субота</span><span>10:00 – 16:00</span></li>
        <li><span>Неділя</span><span>вихідний</span></li>
      </ul>
      <a href="/kontakty#forma" class="btn btn-outline" style="margin-top:1.25rem;font-size:.875rem;padding:.6rem 1.25rem">
        Написати нам
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} HoReCa Меблі. Усі права захищені.</p>
      <nav aria-label="Юридична навігація">
        <a href="/privacy">Конфіденційність</a>
        <a href="/terms">Умови використання</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: rgba(250, 247, 242, .7);
    margin-top: auto;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 4rem 3rem;
  }

  @media (min-width: 600px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 900px) {
    .footer-inner { grid-template-columns: 2fr 1fr 1fr 1fr; }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1.25rem;
  }

  .footer-logo-name {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-light);
  }

  .footer-desc {
    font-size: .9rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    max-width: 36ch;
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    margin-bottom: 1.25rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .9rem;
    color: rgba(250, 247, 242, .8);
    transition: color var(--transition);
  }

  .contact-link:hover { color: var(--color-secondary); }

  .social-links {
    display: flex;
    gap: .75rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(250, 247, 242, .08);
    color: rgba(250, 247, 242, .7);
    transition: background var(--transition), color var(--transition);
  }

  .social-links a:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .footer-heading {
    font-family: var(--font-body);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-light);
    margin-bottom: 1rem;
  }

  .footer-nav-col ul { display: flex; flex-direction: column; gap: .5rem; }

  .footer-link {
    font-size: .9rem;
    color: rgba(250, 247, 242, .65);
    transition: color var(--transition);
  }

  .footer-link:hover { color: var(--color-secondary); }

  .hours-list {
    display: flex;
    flex-direction: column;
    gap: .4rem;
  }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    font-size: .875rem;
    gap: 1rem;
  }

  .hours-list li span:last-child { color: var(--color-light); }

  .footer-bottom {
    border-top: 1px solid rgba(250, 247, 242, .08);
  }

  .footer-bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
    font-size: .8125rem;
  }

  .footer-bottom-inner nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom-inner nav a {
    color: rgba(250, 247, 242, .5);
    transition: color var(--transition);
  }

  .footer-bottom-inner nav a:hover { color: rgba(250, 247, 242, .9); }
</style>
