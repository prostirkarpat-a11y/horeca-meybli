---
import Layout from '@/layouts/Layout.astro';

const contacts = [
  {
    icon: '📍',
    title: 'Адреса офісу / шоуруму',
    lines: ['вул. Столярна, 15, Київ', '02000, Україна'],
    href: 'https://maps.google.com',
    cta:  'Прокласти маршрут',
  },
  {
    icon: '📞',
    title: 'Телефон',
    lines: ['+38 (000) 123-45-67', '+38 (000) 765-43-21'],
    href: 'tel:+380001234567',
    cta:  'Зателефонувати',
  },
  {
    icon: '✉️',
    title: 'Email',
    lines: ['info@horeca-meybli.com', 'sales@horeca-meybli.com'],
    href: 'mailto:info@horeca-meybli.com',
    cta:  'Написати листа',
  },
  {
    icon: '⏰',
    title: 'Графік роботи',
    lines: ['Пн – Пт: 9:00 – 18:00', 'Субота: 10:00 – 16:00'],
    href: null,
    cta:  null,
  },
];

const messengers = [
  { label: 'Telegram',  href: 'https://t.me',              color: '#2AABEE' },
  { label: 'Viber',     href: 'viber://chat?number=380001234567', color: '#7360F2' },
  { label: 'WhatsApp',  href: 'https://wa.me/380001234567',color: '#25D366' },
];
---

<Layout
  title="Контакти"
  description="Контактна інформація HoReCa Меблі: адреса, телефон, email, форма зворотного зв'язку. Шоурум у Києві."
>
  <!-- Page hero -->
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Хлібні крихти">
        <a href="/">Головна</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Контакти</span>
      </nav>
      <h1>Контакти</h1>
      <p>Зв'яжіться з нами будь-яким зручним способом</p>
    </div>
  </div>

  <section class="section">
    <div class="container contacts-layout">

      <!-- Contacts info -->
      <aside class="contacts-info">
        <div class="contact-cards">
          {contacts.map(({ icon, title, lines, href, cta }) => (
            <div class="contact-card">
              <span class="contact-icon" aria-hidden="true">{icon}</span>
              <div>
                <h2 class="contact-title">{title}</h2>
                {lines.map(l => <p class="contact-line">{l}</p>)}
                {href && cta && (
                  <a href={href} class="contact-cta btn btn-ghost">
                    {cta} →
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Messengers -->
        <div class="messengers">
          <p class="messengers-label">Написати у месенджер:</p>
          <div class="messengers-row">
            {messengers.map(({ label, href, color }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="messenger-btn"
                style={`--msg-color: ${color}`}
              >
                {label}
              </a>
            ))}
          </div>
        </div>
      </aside>

      <!-- Contact form -->
      <div id="forma" class="form-wrapper">
        <div class="form-card">
          <h2 class="form-heading">Залишити запит</h2>
          <p class="form-sub">Менеджер зв'яжеться протягом робочого дня</p>

          <form class="contact-form" novalidate>
            <div class="form-row">
              <label class="field">
                <span class="field-label">Ім'я *</span>
                <input type="text" name="name" placeholder="Як до вас звертатись?" required autocomplete="name" />
              </label>
              <label class="field">
                <span class="field-label">Телефон *</span>
                <input type="tel" name="phone" placeholder="+38 (0__) ___-__-__" required autocomplete="tel" />
              </label>
            </div>

            <label class="field">
              <span class="field-label">Email</span>
              <input type="email" name="email" placeholder="your@email.com" autocomplete="email" />
            </label>

            <label class="field">
              <span class="field-label">Тип закладу</span>
              <select name="type">
                <option value="">— Оберіть тип закладу —</option>
                <option>Ресторан</option>
                <option>Кафе / кав'ярня</option>
                <option>Готель</option>
                <option>Бар</option>
                <option>Мережа закладів</option>
                <option>Інше</option>
              </select>
            </label>

            <label class="field">
              <span class="field-label">Кількість місць</span>
              <input type="number" name="seats" placeholder="Орієнтовна кількість посадкових місць" min="1" />
            </label>

            <label class="field">
              <span class="field-label">Повідомлення</span>
              <textarea name="message" rows="4" placeholder="Розкажіть про ваш проєкт, бюджет, бажані строки..."></textarea>
            </label>

            <label class="checkbox-label">
              <input type="checkbox" required />
              <span>
                Я погоджуюсь з
                <a href="/privacy">умовами конфіденційності</a>
              </span>
            </label>

            <button type="submit" class="btn btn-primary submit-btn">
              Надіслати запит
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map placeholder -->
  <div class="map-section">
    <div class="map-placeholder img-placeholder">
      <div class="map-overlay">
        <p class="map-address">📍 вул. Столярна, 15, Київ</p>
        <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Відкрити в Google Maps
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    // TODO: wire to backend / Netlify Forms / Formspree / CF Worker
    const btn = form.querySelector<HTMLButtonElement>('.submit-btn')!;
    btn.textContent = '✓ Запит надіслано!';
    btn.disabled = true;
    btn.style.background = 'var(--color-accent)';
  });
</script>

<style>
  .page-hero {
    background: linear-gradient(to right, var(--color-light), var(--color-border));
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero h1 { margin-bottom: .5rem; }
  .page-hero p { color: var(--color-text-muted); }

  .breadcrumb {
    display: flex; align-items: center; gap: .5rem;
    font-size: .875rem; color: var(--color-text-muted); margin-bottom: 1rem;
  }
  .breadcrumb a { color: var(--color-primary); }
  .breadcrumb a:hover { text-decoration: underline; }

  /* Layout */
  .contacts-layout {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .contacts-layout { grid-template-columns: 1fr; }
  }

  /* Contact cards */
  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .contact-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color var(--transition);
  }

  .contact-card:hover { border-color: var(--color-secondary); }

  .contact-icon { font-size: 1.5rem; flex-shrink: 0; margin-top: .1rem; }

  .contact-title {
    font-family: var(--font-body);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: .35rem;
  }

  .contact-line { font-size: .9375rem; color: var(--color-text); line-height: 1.5; }

  .contact-cta {
    font-size: .875rem;
    margin-top: .35rem;
    padding-inline: 0;
  }

  /* Messengers */
  .messengers { padding: 1.25rem; background: var(--color-light); border-radius: var(--radius-md); }
  .messengers-label { font-size: .8125rem; color: var(--color-text-muted); margin-bottom: .75rem; }
  .messengers-row { display: flex; gap: .625rem; flex-wrap: wrap; }

  .messenger-btn {
    padding: .5rem 1.125rem;
    border-radius: 999px;
    font-size: .875rem;
    font-weight: 500;
    color: #fff;
    background: var(--msg-color);
    transition: opacity var(--transition), transform var(--transition);
  }

  .messenger-btn:hover { opacity: .85; transform: translateY(-1px); }

  /* Form */
  .form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .form-heading { font-size: 1.5rem; margin-bottom: .5rem; }
  .form-sub { color: var(--color-text-muted); font-size: .9375rem; margin-bottom: 2rem; }

  .contact-form { display: flex; flex-direction: column; gap: 1.125rem; }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .form-row { grid-template-columns: 1fr; }
    .form-card { padding: 1.5rem; }
  }

  .field { display: flex; flex-direction: column; gap: .375rem; }

  .field-label {
    font-size: .8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: .03em;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: .75rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: .9375rem;
    color: var(--color-text);
    background: var(--color-light);
    transition: border-color var(--transition), background var(--transition);
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    background: #fff;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #bfb0a5;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: .625rem;
    font-size: .875rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .checkbox-label input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
    cursor: pointer;
  }

  .checkbox-label a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    padding: .9rem;
    font-size: 1rem;
    font-weight: 600;
    transition: background var(--transition), box-shadow var(--transition);
  }

  .submit-btn:hover:not(:disabled) {
    box-shadow: 0 4px 20px rgba(124,74,30,.3);
  }

  .submit-btn:disabled { cursor: default; }

  /* Map */
  .map-section { height: 380px; }

  .map-placeholder {
    width: 100%;
    height: 100%;
    position: relative;
    background:
      linear-gradient(rgba(28,15,5,.35), rgba(28,15,5,.35)),
      repeating-linear-gradient(0deg, #e0cbb5 0, #e0cbb5 1px, transparent 1px, transparent 60px),
      repeating-linear-gradient(90deg, #e0cbb5 0, #e0cbb5 1px, transparent 1px, transparent 60px),
      var(--color-border);
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .map-address {
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    background: rgba(28,15,5,.7);
    padding: .5rem 1rem;
    border-radius: var(--radius-md);
    backdrop-filter: blur(4px);
  }
</style>
