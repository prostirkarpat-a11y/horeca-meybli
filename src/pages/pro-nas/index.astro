---
import Layout from '@/layouts/Layout.astro';

const values = [
  {
    title: 'Якість у деталях',
    desc: 'Кожна деталь меблів — від вибору дерева до фінішного лаку — проходить багатоетапний контроль якості.',
  },
  {
    title: 'Чесність та прозорість',
    desc: 'Фіксуємо ціну у договорі, не маємо прихованих витрат, звітуємо на кожному етапі виробництва.',
  },
  {
    title: 'Екологічна відповідальність',
    desc: 'Використовуємо сертифіковану деревину, безпечні лаки та мінімізуємо відходи виробництва.',
  },
  {
    title: 'Довгострокове партнерство',
    desc: 'Будуємо стосунки, а не продаємо угоди. 70% клієнтів повертаються з новими проєктами.',
  },
];

const team = [
  { name: 'Іван Коваленко',   role: 'Засновник та директор',    since: 2014 },
  { name: 'Марина Сидоренко', role: 'Головний дизайнер',         since: 2016 },
  { name: 'Андрій Бойко',     role: 'Технічний директор',        since: 2015 },
  { name: 'Олена Мельник',    role: 'Менеджер з продажів',       since: 2019 },
];

const milestones = [
  { year: 2014, text: 'Заснування компанії. Перший заклад — кав\'ярня у Києві.' },
  { year: 2016, text: 'Відкрили власний завод площею 1 200 м². Запустили лінію ЧПУ-обробки.' },
  { year: 2018, text: 'Перший великий готельний проєкт. Вийшли на ринок готельного оснащення.' },
  { year: 2020, text: 'Попри пандемію — зростання: збільшили виробничі потужності на 40%.' },
  { year: 2022, text: 'Запустили онлайн-каталог та 3D-візуалізацію для клієнтів.' },
  { year: 2024, text: 'Понад 500 реалізованих проєктів. Команда — 45 спеціалістів.' },
];
---

<Layout
  title="Про нас"
  description="HoReCa Меблі — виробник дерев'яних меблів для HoReCa з 2014 року. Власне виробництво, 500+ проєктів, команда 45 спеціалістів."
>
  <!-- Hero -->
  <div class="about-hero">
    <div class="container about-hero-inner">
      <div>
        <nav class="breadcrumb" aria-label="Хлібні крихти">
          <a href="/">Головна</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Про нас</span>
        </nav>
        <p class="section-label">Хто ми</p>
        <h1>Виробник меблів для&nbsp;HoReCa з&nbsp;2014&nbsp;року</h1>
        <p class="about-hero-desc">
          Ми — команда майстрів, дизайнерів та менеджерів, які допомагають
          ресторанам, кафе та готелям виглядати саме так, як вони уявляють.
          Від першого ескізу до останнього гвинтика — під ключ.
        </p>
      </div>
      <div class="about-numbers">
        {[
          { v: '10+', l: 'років на ринку' },
          { v: '45',  l: 'спеціалістів' },
          { v: '500+',l: 'проєктів' },
          { v: '1 200', l: 'м² заводу' },
        ].map(({ v, l }) => (
          <div class="about-num">
            <strong>{v}</strong>
            <span>{l}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Story -->
  <section class="section">
    <div class="container story-grid">
      <div>
        <p class="section-label">Наша історія</p>
        <h2 class="section-heading">Від майстерні до заводу</h2>
        <div class="divider"></div>
        <div class="story-text">
          <p>
            У 2014 році засновник компанії Іван Коваленко відкрив невелику столярну
            майстерню в Києві. Першим замовленням стала стійка для маленької кав'ярні
            на Подолі — той самий заклад досі є нашим клієнтом.
          </p>
          <p>
            За десять років компанія виросла до повноцінного виробничого підприємства
            з власним заводом, командою 45 спеціалістів та сотнями реалізованих
            об'єктів по всій Україні.
          </p>
          <p>
            Ми залишаємось вірними принципу: кожні меблі — це частина інтер'єру,
            а інтер'єр — це обличчя вашого бізнесу. Тому ми не просто виробляємо,
            а радимо, проєктуємо та супроводжуємо.
          </p>
        </div>
      </div>
      <!-- Timeline -->
      <div class="timeline">
        {milestones.map(({ year, text }) => (
          <div class="timeline-item">
            <span class="timeline-year">{year}</span>
            <div class="timeline-dot" aria-hidden="true"></div>
            <p class="timeline-text">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section values-section">
    <div class="container">
      <p class="section-label">Наші принципи</p>
      <h2 class="section-heading">Цінності компанії</h2>
      <div class="divider"></div>
      <div class="values-grid">
        {values.map(({ title, desc }) => (
          <div class="value-card">
            <div class="value-line" aria-hidden="true"></div>
            <h3 class="value-title">{title}</h3>
            <p class="value-desc">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container">
      <p class="section-label">Команда</p>
      <h2 class="section-heading">Люди за меблями</h2>
      <div class="divider"></div>
      <div class="team-grid">
        {team.map(({ name, role, since }) => (
          <div class="team-card">
            <div class="team-avatar img-placeholder" aria-hidden="true">
              <span class="team-initials">{name.split(' ').map(n => n[0]).join('')}</span>
            </div>
            <div class="team-info">
              <h3 class="team-name">{name}</h3>
              <p class="team-role">{role}</p>
              <p class="team-since">У компанії з {since}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="container about-cta-inner">
      <h2>Хочете дізнатись більше?</h2>
      <p>Запросіть нас на об'єкт або завітайте до нашого шоуруму в Києві.</p>
      <div class="cta-btns">
        <a href="/kontakty#forma" class="btn btn-primary">Зв'язатись з нами</a>
        <a href="/portfolio" class="btn btn-outline">Наші роботи</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .about-hero {
    background: linear-gradient(to right, var(--color-light), #efe3d4);
    border-bottom: 1px solid var(--color-border);
    padding-block: 4rem;
  }

  .about-hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .about-hero-inner { grid-template-columns: 1fr; }
  }

  .breadcrumb {
    display: flex; align-items: center; gap: .5rem;
    font-size: .875rem; color: var(--color-text-muted); margin-bottom: 1rem;
  }
  .breadcrumb a { color: var(--color-primary); }
  .breadcrumb a:hover { text-decoration: underline; }

  .about-hero-desc {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin-top: 1rem;
    max-width: 56ch;
  }

  .about-numbers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    min-width: 220px;
  }

  .about-num {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 1rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .about-num strong {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: .25rem;
  }

  .about-num span { font-size: .75rem; color: var(--color-text-muted); }

  /* Story */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .story-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .story-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: .9375rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 1.75rem;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: .75rem;
  }

  .timeline-year {
    font-family: var(--font-heading);
    font-size: .9375rem;
    font-weight: 600;
    color: var(--color-primary);
    grid-column: 2;
    grid-row: 1;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-secondary);
    border: 2px solid var(--color-surface);
    box-shadow: 0 0 0 2px var(--color-secondary);
  }

  .timeline-text {
    font-size: .9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    grid-column: 2;
    grid-row: 2;
  }

  /* Values */
  .values-section { background: var(--color-light); }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem;
  }

  .value-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .value-line {
    width: 40px;
    height: 3px;
    background: var(--color-secondary);
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }

  .value-title { font-size: 1.0625rem; margin-bottom: .5rem; }
  .value-desc { font-size: .9rem; color: var(--color-text-muted); line-height: 1.65; }

  /* Team */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1.5rem;
  }

  .team-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    transition: box-shadow var(--transition);
  }

  .team-card:hover { box-shadow: var(--shadow-md); }

  .team-avatar {
    height: 200px;
  }

  .team-initials {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    opacity: .4;
  }

  .team-info { padding: 1.25rem 1.5rem; }
  .team-name { font-size: 1.0625rem; margin-bottom: .25rem; }
  .team-role { font-size: .875rem; color: var(--color-text-muted); margin-bottom: .25rem; }
  .team-since { font-size: .8125rem; color: var(--color-text-muted); opacity: .7; }

  /* CTA */
  .about-cta {
    background: var(--color-light);
    border-top: 1px solid var(--color-border);
    padding-block: 4rem;
  }

  .about-cta-inner { text-align: center; max-width: 560px; margin-inline: auto; }
  .about-cta-inner h2 { margin-bottom: .75rem; }
  .about-cta-inner p { color: var(--color-text-muted); margin-bottom: 2rem; margin-inline: auto; }

  .cta-btns { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
</style>
